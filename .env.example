# Telegram API Credentials
# Obtain your API ID and API HASH by creating an application at https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=telegram_crawler

# Channel and Crawler Configuration
DEFAULT_CHANNEL=anarconomy
DATABASE_PATH=crawler.db
BATCH_SIZE=100
RATE_LIMIT_DELAY=1.0
LOG_LEVEL=INFO

# Media Download Configuration
DOWNLOAD_MEDIA=true
MEDIA_DIRECTORY=media
MEDIA_MAX_RETRIES=3
MEDIA_RETRY_DELAY=5
